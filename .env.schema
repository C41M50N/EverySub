# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$VARLOCK_ENV
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# @required @sensitive @type=url
DATABASE_URL=
# @required @sensitive @type=string
BETTER_AUTH_SECRET=
# @required @type=url
BETTER_AUTH_URL=
# @required @type=string
GOOGLE_CLIENT_ID=
# @required @sensitive @type=string
GOOGLE_CLIENT_SECRET=
# logo.dev secret key, used server-side for the Brand Search API
# @required=false @sensitive @type=string
LOGO_DEV_SECRET_KEY=
# logo.dev publishable key, safe to expose to the browser for logo image URLs
# @required=false @type=string
LOGO_DEV_PUBLISHABLE_KEY=
# OpenAI API key for smart import. Smart import is disabled when unset.
# @required=false @sensitive @type=string
OPENAI_API_KEY=
# Resend API key for notification emails. Email delivery is unavailable when unset.
# @required=false @sensitive @type=string
RESEND_API_KEY=
# Sender for notification emails, on a domain verified in Resend, e.g. "EverySub <notifications@mail.everysub.com>"
# @required=false @type=string
RESEND_FROM_ADDRESS=
# Signing secret for the Resend webhook that reports email delivery events to /api/webhooks/resend
# @required=false @sensitive @type=string
RESEND_WEBHOOK_SECRET=
