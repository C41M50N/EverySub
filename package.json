{
  "name": "everysub",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "if [ -e .git ]; then git config core.hooksPath .githooks; fi",
    "dev": "PORTLESS_TLD=com,dev,app portless dev.everysub vite dev",
    "build": "vite build",
    "start": "varlock run -- srvx serve --prod --dir . --static dist/client --entry dist/server/server.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run",
    "invoices:process": "varlock run -- bun src/jobs/process-due-invoices.ts",
    "jobs:run": "varlock run -- bun src/jobs/run-scheduled-jobs.ts",
    "email:dev": "email dev --dir src/features/notifications/email/previews --port 3030",
    "import:eval": "varlock run -- bun scripts/smart-import-eval.ts",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:push": "varlock run -- drizzle-kit push",
    "db:studio": "varlock run -- drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "@base-ui/react": "^1.6.0",
    "@cbuff/ai": "^3.0.0",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.45",
    "ai": "^7.0.116",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.545.0",
    "nanoid-dictionary": "^5.0.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-email": "6.11.0",
    "recharts": "3.8.0",
    "resend": "^6.32.0",
    "shadcn": "^4.13.0",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "srvx": "^0.11.20",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "varlock": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@varlock/vite-integration": "^1.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.72.0",
    "portless": "^0.15.4",
    "railway": "^3.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
