# Loaded when VARLOCK_ENV=test (see the `test` script). Every schema item is
# set here, so tests never pick up real credentials from .env.local. Optional
# items use "" because an empty value would fall through to .env.local.

DATABASE_URL=postgres://everysub:everysub@localhost:5432/everysub_test
BETTER_AUTH_SECRET=test-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
LOGO_DEV_SECRET_KEY=""
LOGO_DEV_PUBLISHABLE_KEY=""
OPENAI_API_KEY=""
RESEND_API_KEY=re_test
RESEND_FROM_ADDRESS="EverySub <notify@mail.example.com>"
RESEND_WEBHOOK_SECRET=""
